{
  "functions": {
    "api/work-content.ts": {
      "includeFiles": "lib/server/prebuilt-work/**"
    },
    "api/work-unlock.ts": {
      "includeFiles": "lib/server/prebuilt-work/**"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/html.*"
        }
      ],
      "destination": "/index.html"
    }
  ]
}
